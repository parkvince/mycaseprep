generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?  @db.Text
  password       String?
  createdAt      DateTime      @default(now())
  unlimitedCases Boolean       @default(false)
  bonusCases     Int           @default(0)
  banned         Boolean       @default(false)
  caseSessions   CaseSession[]
  dailyUsage     DailyUsage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model CaseSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String
  caseType     String?
  firm         String
  difficulty   String
  caseTitle    String
  duration     Int
  hintsUsed    Int      @default(0)
  overallScore Int?
  transcript   Json?
  guidedScore  Int?
  completedAt  DateTime @default(now())
}

model DailyUsage {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  casesUsed   Int      @default(0)
  windowStart DateTime @default(now())
  @@unique([userId])
}

// FEEDBACK-FEATURE: support/feedback submissions from the /feedback page. email
// is required so the operator can reply. Not relationally linked to User (userId
// is a plain optional id) so feedback survives even if the account is deleted.
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  category  String   @default("general")
  message   String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

// AUDIT-LOG: immutable trail of privileged admin actions (ban/delete/grant/
// feedback moderation) so there's a record of who did what, when. Written by
// src/lib/audit.ts; viewed under the admin panel's "Activity" tab.
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminEmail  String
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
}