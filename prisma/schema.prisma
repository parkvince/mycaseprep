generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  email     String
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  type           String
  firm           String
  difficulty     String
  caseTitle      String
  duration       Int
  hintsUsed      Int      @default(0)
  overallScore   Int?
  transcript     Json?
  guidedScore    Int?
  completedAt    DateTime @default(now())
}